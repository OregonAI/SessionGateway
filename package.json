{
  "name": "session-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check": "node scripts/check.ts format:check lint typecheck guard:tsc lint:boundaries fixture:verify snapshot:verify model:verify test",
    "check:static": "npm run --silent check -- --skip test",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\" vitest.config.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\" vitest.config.ts",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "guard:tsc": "node scripts/guard.ts tsc-version",
    "lint:boundaries": "node scripts/guard.ts boundaries",
    "fixture:verify": "node scripts/fixture/verify.ts",
    "snapshot:verify": "node scripts/snapshot/verify.ts",
    "test": "vitest run",
    "license:check": "node scripts/license-check.ts",
    "model:fetch": "node scripts/model/fetch.ts",
    "model:verify": "node scripts/model/verify.ts",
    "eval": "node scripts/eval/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "onnxruntime-node": "1.31.1",
    "pino": "10.4.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "fsevents": false,
    "onnxruntime-node": false
  }
}
